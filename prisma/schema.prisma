// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  tcNumber         String   @unique
  birthDate        DateTime
  grade            String // Sınıf (zorunlu)
  phone            String?
  email            String?
  address          String // Adres (zorunlu)
  // Anne Bilgileri (Zorunlu)
  motherName       String
  motherTc         String
  motherPhone      String
  motherAddress    String
  motherOccupation String

  // Baba Bilgileri (Zorunlu)
  fatherName          String
  fatherTc            String
  fatherPhone         String
  fatherAddress       String
  fatherOccupation    String
  // Öğrenim Ücreti (Sadece Admin tarafından düzenlenebilir)
  announcedTuitionFee String? // Kurumun ilan ettiği ücret
  studentTuitionFee   String? // Öğrenci için belirlenen ücret
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now())

  // Relations
  clubSelections       ClubSelection[]
  newRegistrations     NewRegistration[]
  renewals             Renewal[]
  uniformContracts     UniformContract[]
  mealContracts        MealContract[]
  serviceContracts     ServiceContract[]
  bookContracts        BookContract[]
  activities           Activity[]
  activityParticipants ActivityParticipant[]
  parentMeetings       ParentMeeting[]
  classAssignments     ClassStudent[] // Sınıf atamaları (FAZ 2)
  parents              ParentStudent[] // Veli ilişkileri (FAZ 1 - Genişletme)
  homeworkAssignments  HomeworkAssignment[] // Ödev atamaları (FAZ 2)
  attendances          Attendance[] // Yoklamalar (FAZ 2)
  examResults          ExamResult[] // Sınav sonuçları (FAZ 3)
  comments             StudentComment[] // Öğretmen/Rehberlik görüşleri (FAZ 4)

  @@map("students")
}

model Club {
  id          String   @id @default(cuid())
  name        String
  description String?
  capacity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  // Relations
  selections ClubSelection[]

  @@map("clubs")
}

model ClubSelection {
  id        String   @id @default(cuid())
  studentId String
  clubId    String
  createdAt DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([studentId, clubId])
  @@map("club_selections")
}

model NewRegistration {
  id           String   @id @default(cuid())
  studentId    String
  // Yeni kayıt sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("new_registrations")
}

model Renewal {
  id           String   @id @default(cuid())
  studentId    String
  // Kayıt yenileme sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("renewals")
}

model UniformContract {
  id           String   @id @default(cuid())
  studentId    String
  // Forma sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("uniform_contracts")
}

model MealContract {
  id           String   @id @default(cuid())
  studentId    String
  // Yemek sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("meal_contracts")
}

model ServiceContract {
  id           String   @id @default(cuid())
  studentId    String
  // Servis sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("service_contracts")
}

model BookContract {
  id           String   @id @default(cuid())
  studentId    String
  // Kitap sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("book_contracts")
}

// Başvuru sisteminden gelen başvurular
model Basvuru {
  id             String   @id @default(cuid())
  externalId     String   @unique // Başvuru sistemindeki ID
  ogrenciAdSoyad String
  ogrenciTc      String
  okul           String
  ogrenciSinifi  String
  ogrenciSube    String   @default("Belirtilmedi")
  sinavGunu      String   @default("Belirtilmedi")
  babaAdSoyad    String
  babaMeslek     String
  babaIsAdresi   String   @default("")
  babaCepTel     String
  anneAdSoyad    String
  anneMeslek     String
  anneIsAdresi   String   @default("")
  anneCepTel     String
  email          String
  createdAt      DateTime @default(now())
  syncedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // İletişim durumu ve notları
  contactStatus   ContactStatus @default(ILETISIME_GECILMEDI)
  contactNote     String?
  lastContactedAt DateTime?
  lastContactedBy String?

  @@index([externalId])
  @@index([ogrenciTc])
  @@index([email])
  @@index([createdAt])
  @@map("basvurular")
}

// Bursluluk başvuruları için iletişim durumu
enum ContactStatus {
  ILETISIME_GECILDI
  ILETISIME_GECILMEDI
}

// Yaz okulu başvuruları (basvuru-sistemi webhook)
model YazOkuluBasvuru {
  id             String   @id @default(cuid())
  externalId     String   @unique
  ogrenciAd      String
  ogrenciSoyad   String
  okul           String
  ogrenciSinifi  String
  veliAd         String
  veliSoyad      String
  veliTelefon    String
  createdAt      DateTime @default(now())
  syncedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contactStatus   ContactStatus @default(ILETISIME_GECILMEDI)
  contactNote     String?
  lastContactedAt DateTime?
  lastContactedBy String?

  @@index([externalId])
  @@index([veliTelefon])
  @@index([createdAt])
  @@map("yaz_okulu_basvurular")
}

// İK öğretmen başvuruları (ik-leventokullari webhook)
enum HrApplicationStatus {
  YENI
  INCELENDI
  GORUSME
  RED
  ISE_ALINDI
}

enum HrApplicationMeetingOutcome {
  OLUMLU
  KARARSIZ
  OLUMSUZ
  TEKLIF
  ISE_ALINDI
  RED
}

enum HrApplicationSource {
  WEBSITE
  MANUAL
}

model HrJobApplication {
  id                       String              @id @default(cuid())
  externalId               String              @unique
  source                   HrApplicationSource @default(WEBSITE)
  fullName                 String
  residence                String
  birthYear                Int
  phone                    String
  universityDepartment     String
  formationStatus          String
  appliedBranch            String
  experienceLevels         Json // string[] — Ortaokul, Lise
  totalExperience          String
  hasPrivateSchoolExperience Boolean
  pedagogicalApproach      String              @db.Text
  clubsAndActivities       String              @db.Text
  references               Json // { firstName, lastName, title, phone }[]
  cvUrl                    String
  cvFileName               String
  status                   HrApplicationStatus @default(YENI)
  internalNote             String?             @db.Text
  assignedToStaffId        String?
  lastContactedAt          DateTime?
  lastMeetingAt            DateTime?
  lastMeetingOutcome       HrApplicationMeetingOutcome?
  createdAt                DateTime
  syncedAt                 DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  meetings HrJobApplicationMeeting[]

  @@index([externalId])
  @@index([source])
  @@index([appliedBranch])
  @@index([status])
  @@index([createdAt])
  @@index([lastMeetingAt])
  @@map("hr_job_applications")
}

model HrJobApplicationMeeting {
  id            String                      @id @default(cuid())
  applicationId String
  application   HrJobApplication            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  meetingAt     DateTime
  conductedById String?
  conductedBy   Staff?                      @relation("ConductedHrApplicationMeetings", fields: [conductedById], references: [id], onDelete: SetNull)
  outcome       HrApplicationMeetingOutcome
  notes         String?                     @db.Text
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@index([applicationId])
  @@index([meetingAt])
  @@map("hr_job_application_meetings")
}

// ============================================
// FAALİYET YÖNETİMİ — Yeni Modüller
// ============================================

enum ActivityMainType {
  EGITIM // Eğitim
  GEZI // Gezi
  GORSEL_SANATLAR // Görsel Sanatlar
  MUZIK // Müzik
  GASTRONOMI // Gastronomi
  PROJE // Proje
  SPOR // Spor
  TURNUVA // Turnuva
}

enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

model ActivityEvent {
  id              String           @id @default(cuid())
  mainType        ActivityMainType
  subtype         String? // ingilizce, ingilizce_fen, ingilizce_mat, ispanyolca, robotik, yapay_zeka, vb.
  certificateType String // hangi sertifika şablonu kullanılacak
  title           String
  description     String?
  outcome         String?
  startDate       DateTime
  endDate         DateTime
  location        String?
  organizerName   String
  durationHours   Int?
  durationDays    Int?
  durationMonths  Int?
  durationYears   Int?
  evidenceUrls    String[]         @default([])
  metadata        Json? // Kategori'ye özgü ek alanlar (örn: gezi türü, gezi programı)
  teacherId       String
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  teacher      Staff                 @relation("TeacherActivityEvents", fields: [teacherId], references: [id])
  participants ActivityParticipant[]

  @@index([mainType])
  @@index([teacherId])
  @@index([startDate])
  @@index([createdAt])
  @@map("activity_events")
}

model ActivityParticipant {
  id                    String                     @id @default(cuid())
  activityId            String
  studentId             String
  score                 Int? // 0-100
  languageLevel         LanguageLevel? // sadece dil eğitimlerinde
  participationPhotoUrl String?
  artworkDescription    String? // Görsel Sanatlar Etkinlik — eser açıklaması
  tournamentPlacement   String? // Turnuva başarı belgesi — derece / sıralama metni (serbest)
  projectRole           String? // Proje içerik belgesi — katılımcının rolü
  extraDocumentUrl      String? // öğrenciye özel ek belge (PDF)
  verificationStatus    ActivityVerificationStatus @default(IMZA_SURECINDE)
  signedDocumentUrls    String[]                   @default([])
  signedCurriculumUrls  String[]                   @default([])
  isVerified            Boolean                    @default(false)
  verifiedBy            String?
  verifiedAt            DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  activity ActivityEvent @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([activityId, studentId])
  @@index([activityId])
  @@index([studentId])
  @@index([verificationStatus])
  @@map("activity_participants")
}

// ============================================
// IB Programı — Legacy (korunuyor)
// ============================================

// IB Programı - Öğrenci Faaliyet Kayıtları
enum ActivityType {
  ETKINLIK // Etkinlik
  GEZI // Gezi
  PROJE // Proje
  SINAV // Sınav
  YARISMA // Yarışma
  SEMINER // Seminer
  WORKSHOP // Workshop
  SPORT // Spor
  SANAT // Sanat
  SOSYAL // Sosyal Sorumluluk
  DIL // Dil Faaliyeti
  BILIM // Bilim
  DEGER // Değerler Eğitimi
  DIGER // Diğer
}

// Doğrulama protokolü: İmza sürecinde → Onay bekliyor → Onaylandı
enum ActivityVerificationStatus {
  IMZA_SURECINDE // PDF indirildi, belgeler imzalanıyor / imzalı belge henüz yüklenmedi
  ONAY_BEKLIYOR // İmzalı belgeler yüklendi, inceleme bekliyor
  ONAYLANDI // Yetkili tarafından onaylandı
}

model Activity {
  id                    String                     @id @default(cuid())
  studentId             String
  type                  ActivityType
  title                 String // Faaliyet başlığı
  description           String? // Detaylı açıklama
  activityDate          DateTime // Faaliyet tarihi (IMMUTABLE - değiştirilemez)
  location              String? // Konum
  organizer             String? // Organizatör/Koordinatör
  duration              Int? // Süre (dakika)
  participants          Int? // Katılımcı sayısı
  outcome               String? // Sonuç/Kazanım
  evidence              String? // Kanıt (dosya yolu, link vb.)
  isVerified            Boolean                    @default(false) // ONAYLANDI ise true (geriye dönük uyumluluk)
  verifiedBy            String? // Doğrulayan/onaylayan kişi
  verifiedAt            DateTime? // Doğrulama/onay tarihi
  notes                 String? // Notlar
  certificateData       Json? // Sertifika PDF: başlık, eğitim açıklaması, tarihler, öğretmen/müdür adı
  // Faaliyet Ekle ile uyum: kategori ve alt tür (Eğitim, Etkinlik, Spor, Yarışma)
  category              String? // egitim | etkinlik | spor | yarisma
  subtype               String? // Alt tür (örn: spanish, basketbol)
  participationPhotoUrl String? // Bu öğrencinin faaliyete katılımını kanıtlayan fotoğraf (max 5MB)
  // Doğrulama protokolü: 3 aşama (imza sürecinde → imzalı belge yükle → onaylandı)
  verificationStatus    ActivityVerificationStatus @default(IMZA_SURECINDE)
  signedDocumentUrls    String[]                   @default([]) // Taranıp yüklenen imzalı belge URL'leri (ONAY_BEKLIYOR için)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  createdBy             String? // Oluşturan kullanıcı

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([activityDate])
  @@index([type])
  @@index([isVerified])
  @@index([category])
  @@index([verificationStatus])
  @@map("activities")
}

// IB Programı - Dışarıdan Görüntüleme Yetkisi
model IBViewer {
  id           String    @id @default(cuid())
  username     String    @unique // Özel kullanıcı adı
  password     String // Hash'lenmiş şifre (bcrypt)
  fullName     String // IB Personeli adı
  email        String? // İletişim email
  organization String? // Organizasyon
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([username])
  @@index([isActive])
  @@map("ib_viewers")
}

// Veli Görüşmeleri - Rehberlik Danışmanı Notları
model ParentMeeting {
  id            String   @id @default(cuid())
  studentId     String
  meetingDate   DateTime // Görüşme tarihi
  notes         String // Görüşme notları/detayları
  counselorName String? // Rehberlik danışmanı adı (opsiyonel)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String? // Oluşturan kullanıcı (opsiyonel)

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([meetingDate])
  @@map("parent_meetings")
}

// Personel Yönetimi - Okul Çalışanları
enum StaffDepartment {
  SUPER_ADMIN // Süper Admin (Sistem Yöneticisi)
  OGRETMEN // Öğretmen
  OGRENCI_ISLERI // Öğrenci İşleri
  MUDUR // Müdür
  MUDUR_YARDIMCISI // Müdür Yardımcısı
  REHBERLIK // Rehberlik
  BAS_REHBERLIK // Baş Rehberlik
  MUHASEBE // Muhasebe
  GUZEL_SANATLAR // Güzel Sanatlar
  SPOR // Spor
  KUTUPHANE // Kütüphane
  TEKNIK // Teknik Personel
  TEMIZLIK // Temizlik
  GUVENLIK // Güvenlik
  DIGER // Diğer
}

model Staff {
  id         String          @id @default(cuid())
  firstName  String
  lastName   String
  tcNumber   String          @unique
  email      String?
  phone      String?
  department StaffDepartment
  position   String? // Pozisyon (Müdür, Müdür Yardımcısı, Sınıf Öğretmeni, vs.)
  subject    String? // Branş/Ders (öğretmenler için)
  isActive   Boolean         @default(true)
  hireDate   DateTime? // İşe başlama tarihi
  notes      String? // Notlar

  // Authentication fields (FAZ 1)
  password           String? // Hashed password (bcrypt) - ilk eklemede null, ilk giriş sonrası set edilir
  isFirstLogin       Boolean   @default(true) // İlk giriş mi?
  mustChangePassword Boolean   @default(false) // Zorunlu şifre değişikliği bayrağı
  lastLoginAt        DateTime? // Son giriş tarihi

  // Module Access Permissions
  hasGeziAccess Boolean @default(false) // Gezi Yönetimi erişim yetkisi
  hasIbAccess   Boolean @default(false) // IB Yönetimi erişim yetkisi

  // HRM - Yönetici Notları (sadece üst yönetim okur/yazar)
  adminNotes          Json? // TipTap JSON dokümanı
  adminNotesUpdatedAt DateTime?
  adminNotesUpdatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subjectAssignments    SubjectAssignment[]
  assignedClasses       Class[]             @relation("ClassCounselor")
  teacherSchedules      Schedule[]          @relation("TeacherSchedules")
  homeworks             Homework[]          @relation("TeacherHomeworks")
  attendances           Attendance[]        @relation("TeacherAttendances")
  createdExams          Exam[]              @relation("ExamCreator")
  enteredExamResults    ExamResult[]        @relation("ExamResultEntry")
  studentComments       StudentComment[]    @relation("StaffComments")
  teacherActivityEvents ActivityEvent[]     @relation("TeacherActivityEvents")

  // İç Haberleşme (Chat)
  chatParticipants ConversationParticipant[] @relation("StaffChatParticipants")
  sentMessages     Message[]                 @relation("StaffSentMessages")
  messageReceipts  MessageReceipt[]          @relation("StaffMessageReceipts")

  // HRM
  leaves         StaffLeave[]
  approvedLeaves StaffLeave[] @relation("ApprovedLeaves")
  duties         StaffDuty[]
  permissions    StaffPermission[]
  retentionCycles       StaffRetentionCycle[]
  conductedRetentionMeetings StaffRetentionMeeting[] @relation("ConductedRetentionMeetings")
  conductedHrApplicationMeetings HrJobApplicationMeeting[] @relation("ConductedHrApplicationMeetings")

  @@index([tcNumber])
  @@index([department])
  @@index([isActive])
  @@index([firstName, lastName])
  @@map("staff")
}

// Modül bazlı yetkilendirme (Süper Admin tarafından yönetilir)
model StaffPermission {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  module    String
  action    String
  granted   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, module, action])
  @@index([staffId])
  @@index([module])
  @@map("staff_permissions")
}

// HRM - İzin / Sağlık Raporu / Mazeret
enum LeaveType {
  ANNUAL // Yıllık İzin
  SICK_REPORT // Sağlık Raporu
  EXCUSE // Mazeret İzni
  UNPAID // Ücretsiz İzin
  HOURLY // Saatlik Sevk/İzin
}

enum LeaveStatus {
  PENDING // Onay Bekliyor
  APPROVED // Onaylandı
  REJECTED // Reddedildi
}

model StaffLeave {
  id           String      @id @default(cuid())
  staffId      String
  staff        Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String?     @db.Text
  status       LeaveStatus @default(PENDING)
  approvedById String? // Onaylayan yönetici (Staff ID)
  approvedBy   Staff?      @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  rejectedAt   DateTime?
  decisionNote String? // Onay/Red notu
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([staffId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("staff_leaves")
}

// HRM - Nöbet Çizelgesi
model StaffDuty {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 1-7 (Pazartesi-Pazar)
  location  String // Nöbet Yeri (Örn: Bahçe, 2. Kat)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([dayOfWeek])
  @@map("staff_duties")
}

// HRM - Yıl sonu devam görüşmeleri
enum StaffRetentionOutcome {
  WILL_CONTINUE // Devam Edecek
  UNCERTAIN // Belirsiz
  WILL_NOT_CONTINUE // Devam Etmeyecek
}

model StaffRetentionCycle {
  id                      String                 @id @default(cuid())
  staffId                 String
  staff                   Staff                  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  targetAcademicYearId    String?
  targetAcademicYearLabel String
  currentOutcome          StaffRetentionOutcome?
  lastMeetingAt           DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  meetings                StaffRetentionMeeting[]

  @@unique([staffId, targetAcademicYearLabel])
  @@index([currentOutcome])
  @@index([targetAcademicYearLabel])
  @@map("staff_retention_cycles")
}

model StaffRetentionMeeting {
  id            String                @id @default(cuid())
  cycleId       String
  cycle         StaffRetentionCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  meetingAt     DateTime
  conductedById String?
  conductedBy   Staff?                @relation("ConductedRetentionMeetings", fields: [conductedById], references: [id], onDelete: SetNull)
  outcome       StaffRetentionOutcome
  notes         String?               @db.Text
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([cycleId])
  @@index([meetingAt])
  @@map("staff_retention_meetings")
}

// Neredeyiz Modülü - Yıllık Plan Takip Sistemi

enum DisruptionType {
  PLANLI_OKUL // Planlı/Okul Kaynaklı (Gezi, tören, veli toplantısı, müfettiş ziyareti)
  PLANDISI_DOGAL // Plan Dışı/Doğal (Kar tatili, sel, elektrik kesintisi)
  OGRETMEN_KAYNAKLI // Öğretmen Kaynaklı (Hastalık, hizmet içi eğitim)
}

enum HolidayType {
  RESMI_TATIL // Resmi Tatil (Ulusal ve Dini bayramlar)
  YARILYIL_TATILI // Yarıyıl Tatili
  ARA_TATIL // Ara Tatil
  DIGER // Diğer
}

enum ProgressStatus {
  PLANLANDI // Planlandı (henüz başlanmadı)
  DEVAM_EDIYOR // Devam Ediyor
  TAMAMLANDI // Tamamlandı
  ERTELENDI // Ertelendi
  PENDING_APPROVAL // Onay Bekliyor (Öğretmen tarafından işaretlendi, onay bekliyor)
}

// Akademik Yıl
model AcademicYear {
  id                  String         @id @default(cuid())
  name                String // Örn: "2024-2025 Eğitim Öğretim Yılı"
  startDate           DateTime? // Başlangıç (taslak yılda boş; aktif yapılırken zorunlu)
  endDate             DateTime? // Bitiş (taslak yılda boş; aktif yapılırken zorunlu)
  isActive            Boolean        @default(false) // Aktif akademik yıl
  weekendDays         String[]       @default([]) // Hafta tatili günleri: ["SATURDAY", "SUNDAY"]
  term1Start          DateTime? // 1. dönem başlangıcı
  term1End            DateTime? // 1. dönem bitişi
  term2Start          DateTime? // 2. dönem başlangıcı
  term2End            DateTime? // 2. dönem bitişi
  /// Dolgu: kayıt yenileme hedefi; kullanıcı arayüzünde listelenmez (aktif yıl kaydına bağlı otomatik)
  parentActiveYearId  String?
  parentActiveYear    AcademicYear?  @relation("AcademicYearRenewal", fields: [parentActiveYearId], references: [id], onDelete: Cascade)
  renewalPlaceholders AcademicYear[] @relation("AcademicYearRenewal")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  subjects    Subject[]
  holidays    Holiday[]
  disruptions Disruption[]
  classes     Class[] // Akademik yıla ait sınıflar (FAZ 2)

  @@index([isActive])
  @@index([startDate, endDate])
  @@index([parentActiveYearId])
  @@map("academic_years")
}

model Notification {
  id           String               @id @default(cuid())
  type         NotificationType
  title        String
  message      String
  targetRole   StaffDepartment? // OGRETMEN, REHBERLIK, OGRENCI_ISLERI, null = herkese
  targetUserId String? // Belirli bir kullanıcıya özel (örn: öğretmen)
  isRead       Boolean              @default(false)
  priority     NotificationPriority @default(NORMAL)

  // İlişkili kayıtlar (opsiyonel)
  relatedSubjectId String?
  relatedTopicId   String?
  relatedUnitId    String?
  relatedStaffId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetRole, isRead])
  @@index([targetUserId, isRead])
  @@index([createdAt])
  @@index([type])
  @@map("notifications")
}

enum NotificationType {
  ONAY_BEKLIYOR // Konu tamamlama onayı bekliyor
  TAMAMLANDI // Konu tamamlandı ve onaylandı
  GECIKMELI // Konu gecikmeye girdi
  YAKLASAN_DEADLINE // Yaklaşan bitiş tarihi
  AKSAMA_OLUSTURULDU // Yeni aksama eklendi
  OGRETMEN_ATANDI // Öğretmen derse atandı
  UNITE_TAMAMLANDI // Ünite tamamlandı
  ERKEN_TAMAMLANDI // Konu erken tamamlandı
  HAFTALIK_OZET // Haftalık özet bildirimi
  KRITIK_GECIKME // 5+ gün gecikme
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

// Ders
model Subject {
  id             String   @id @default(cuid())
  academicYearId String
  name           String // Örn: "Geometri"
  code           String? // Ders kodu
  grade          Int // Sınıf: 5, 6, 7, 8, 9, 10, 11, 12
  section        String? // Şube: "A", "B", "C", vb. (opsiyonel)
  classId        String? // Sınıf bağlantısı (FAZ 3 - Neredeyiz entegrasyonu için)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class?              @relation(fields: [classId], references: [id], onDelete: SetNull) // Opsiyonel sınıf bağlantısı
  units        Unit[]
  assignments  SubjectAssignment[]

  @@unique([academicYearId, name, grade, section]) // Aynı akademik yılda aynı ders-sınıf-şube kombinasyonu tekrar edemez
  @@index([academicYearId])
  @@index([academicYearId, grade])
  @@index([academicYearId, grade, section])
  @@index([name, grade])
  @@index([classId])
  @@map("subjects")
}

// Ders-Öğretmen Atama
model SubjectAssignment {
  id        String   @id @default(cuid())
  subjectId String
  staffId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([subjectId, staffId])
  @@index([subjectId])
  @@index([staffId])
  @@map("subject_assignments")
}

// Ünite
model Unit {
  id          String   @id @default(cuid())
  subjectId   String
  name        String // Örn: "Üçgenler"
  order       Int // Sıralama
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@index([subjectId])
  @@index([subjectId, order])
  @@map("units")
}

// Konu
model Topic {
  id                String    @id @default(cuid())
  unitId            String
  name              String // Örn: "Üçgenin İç Açıları"
  order             Int // Sıralama
  plannedStartWeek  Int? // Planlanan başlangıç haftası
  plannedEndWeek    Int? // Planlanan bitiş haftası
  plannedStartDate  DateTime? // Planlanan başlangıç tarihi
  plannedEndDate    DateTime? // Planlanan bitiş tarihi
  estimatedDuration Int? // Tahmini süre (gün)
  description       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  subTopics SubTopic[]
  progress  Progress[]

  @@index([unitId])
  @@index([unitId, order])
  @@index([plannedStartDate])
  @@index([plannedEndDate])
  @@map("topics")
}

// Alt Konu (Opsiyonel)
model SubTopic {
  id          String   @id @default(cuid())
  topicId     String
  name        String
  order       Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([topicId, order])
  @@map("sub_topics")
}

// Tatil
model Holiday {
  id             String      @id @default(cuid())
  academicYearId String
  name           String // Örn: "Kurban Bayramı", "Yarıyıl Tatili"
  type           HolidayType
  startDate      DateTime
  endDate        DateTime
  description    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([academicYearId])
  @@index([startDate, endDate])
  @@index([type])
  @@map("holidays")
}

// Aksama
model Disruption {
  id               String         @id @default(cuid())
  academicYearId   String
  type             DisruptionType
  reason           String // Aksama sebebi (detaylı açıklama)
  startDate        DateTime
  endDate          DateTime
  affectedSubjects String[] // Etkilenen dersler (Subject ID'leri)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String? // Oluşturan kullanıcı

  // Relations
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([academicYearId])
  @@index([startDate, endDate])
  @@index([type])
  @@map("disruptions")
}

// İlerleme Takibi
model Progress {
  id              String         @id @default(cuid())
  topicId         String
  status          ProgressStatus @default(PLANLANDI)
  plannedDate     DateTime? // Planlanan tarih
  actualStartDate DateTime? // Gerçek başlangıç tarihi
  actualEndDate   DateTime? // Gerçek bitiş tarihi
  notes           String? // Notlar
  reportedBy      String? // Bildiren öğretmen (Staff ID) - "Tamamladım" butonuna basan
  reportedAt      DateTime? // Öğretmenin işaretleme tarihi
  markedBy        String? // İşaretleyen (Rehberlik Danışmanı veya Öğrenci İşleri)
  markedAt        DateTime? // İşaretleme tarihi
  approvedBy      String? // Onaylayan (Rehberlik Danışmanı veya Öğrenci İşleri Staff ID)
  approvedAt      DateTime? // Onay tarihi
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([status])
  @@index([actualEndDate])
  @@index([reportedBy])
  @@index([approvedBy])
  @@map("progress")
}

// Teklif Görüşmeleri
enum TeklifGorusmeDurumu {
  OLUMLU
  OLUMSUZ
  BELIRSIZ
}

model TeklifGorusmesi {
  id                  String    @id @default(cuid())
  // Öğrenci Bilgileri
  ogrenciAdSoyad      String
  okul                String
  sinif               String
  // Veli Bilgileri
  veliAdSoyad         String
  veliTelefon         String
  veliEmail           String?
  veliMeslek          String?
  veliAdres           String?
  // Teklif Bilgileri
  teklifEdilenFiyat   Float // Teklif edilen fiyat
  okulFiyati          Float // Okul fiyatı
  sonGecerlilikTarihi DateTime? // Teklifin son geçerlilik tarihi (manuel giriş)
  // Görüşmeyi Sonlandır ile işaretlenene kadar tamamlanmış sayılmaz
  sonlandirildi       Boolean   @default(false)
  // Sistem Bilgileri
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String? // Oluşturan kullanıcı

  // Relations
  kayitlar TeklifGorusmeKaydi[]

  @@index([ogrenciAdSoyad])
  @@index([okul])
  @@index([sinif])
  @@index([createdAt])
  @@index([sonGecerlilikTarihi])
  @@index([sonlandirildi])
  @@map("teklif_gorusmeleri")
}

model TeklifGorusmeKaydi {
  id                String              @id @default(cuid())
  teklifGorusmesiId String
  // Görüşme Bilgileri
  gorusmeTarihi     DateTime // Görüşmenin gerçekleştiği tarih (manuel giriş)
  gorusmeyiYapan    String // Görüşmeyi yapan kişi adı
  durum             TeklifGorusmeDurumu
  durumNotu         String? // Duruma özel not (örn: "Olumlu - %20 indirim teklif edildi")
  genelNot          String? // Genel açıklama/notlar
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  teklifGorusmesi TeklifGorusmesi @relation(fields: [teklifGorusmesiId], references: [id], onDelete: Cascade)

  @@index([teklifGorusmesiId])
  @@index([gorusmeTarihi])
  @@index([durum])
  @@map("teklif_gorusme_kayitlari")
}

// ============================================
// FAZ 2: SINIF YÖNETİMİ MODÜLÜ
// ============================================

// Onay Durumu Enum
enum ApprovalStatus {
  PENDING // Onay Bekliyor
  APPROVED // Onaylandı
  REJECTED // Reddedildi
}

// Sınıf Modeli
model Class {
  id             String   @id @default(cuid())
  name           String // "5/A", "10/B"
  grade          Int // 5, 6, 7, 8, 9, 10, 11, 12
  section        String // "A", "B", "C"
  academicYearId String
  counselorId    String? // Atanan Rehberlik Uzmanı (Staff ID)
  description    String? // Sınıf hakkında notlar
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  counselor    Staff?         @relation("ClassCounselor", fields: [counselorId], references: [id], onDelete: SetNull)
  students     ClassStudent[] // Sınıfa kayıtlı öğrenciler
  schedules    Schedule[] // Sınıfın ders programı
  subjects     Subject[] // Neredeyiz modülü için dersler (FAZ 3)
  homeworks    Homework[] // Sınıfın ödevleri (FAZ 2)
  attendances  Attendance[] // Sınıfın yoklamaları (FAZ 2)
  exams        Exam[] // Sınıfın sınavları (FAZ 3)

  @@unique([academicYearId, name]) // Aynı akademik yılda aynı isimde sınıf olamaz
  @@index([academicYearId])
  @@index([counselorId])
  @@index([grade])
  @@index([academicYearId, grade])
  @@map("classes")
}

// Sınıf-Öğrenci İlişkisi (Pivot Table)
model ClassStudent {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId]) // Bir öğrenci aynı sınıfa birden fazla kez eklenemez
  @@index([classId])
  @@index([studentId])
  @@map("class_students")
}

// Ders Programı
model Schedule {
  id          String   @id @default(cuid())
  classId     String
  subjectName String // "Matematik", "Fizik", "Türkçe"
  teacherId   String // Dersi veren öğretmen (Staff ID)
  dayOfWeek   Int // 1-5 (Pazartesi-Cuma) veya 1-7 (Pazartesi-Pazar)
  startTime   String // "09:00"
  endTime     String // "09:45"
  room        String? // Sınıf/Derslik (örn: "5/A", "Laboratuvar")
  notes       String? // Ders hakkında notlar
  isActive    Boolean  @default(true) // Aktif mi? (Onay mekanizması için)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Staff              @relation("TeacherSchedules", fields: [teacherId], references: [id], onDelete: Cascade)
  approvals   ScheduleApproval[] // Onay talepleri
  attendances Attendance[] // Yoklamalar (FAZ 2)

  @@index([classId])
  @@index([teacherId])
  @@index([dayOfWeek])
  @@index([classId, dayOfWeek])
  @@map("schedules")
}

// Ders Programı Onay Talebi
model ScheduleApproval {
  id          String         @id @default(cuid())
  scheduleId  String? // Mevcut schedule ID (UPDATE/DELETE için), CREATE için null
  classId     String // İlgili sınıf
  changeType  String // "CREATE", "UPDATE", "DELETE"
  requestedBy String // Talebi oluşturan (Rehberlik uzmanı Staff ID)
  status      ApprovalStatus @default(PENDING)
  approvedBy  String? // Onaylayan (Müdür veya Yönetici Staff ID)
  approvedAt  DateTime? // Onay tarihi
  rejectedAt  DateTime? // Red tarihi
  notes       String? // Onay/Red notları

  // Değişiklik detayları (JSON string olarak)
  oldValue String? // Eski değerler (UPDATE/DELETE için)
  newValue String? // Yeni değerler (CREATE/UPDATE için)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([status])
  @@index([requestedBy])
  @@index([classId])
  @@index([status, classId])
  @@map("schedule_approvals")
}

// ============================================
// FAZ 1 - GENİŞLETME: VELİ GİRİŞ SİSTEMİ
// ============================================

// Veli Hesabı (Öğrenci TC bazlı)
// Her öğrenci için bir veli hesabı oluşturulur
// Anne ve baba aynı hesapla giriş yapar (aynı şifre)
model Parent {
  id              String @id @default(cuid())
  studentTcNumber String @unique // Öğrencinin TC'si (giriş için kullanılır)

  // Authentication
  password           String? // Hashed password (bcrypt) - ilk giriş sonrası set edilir
  isFirstLogin       Boolean   @default(true) // İlk giriş mi?
  mustChangePassword Boolean   @default(false) // Zorunlu şifre değişikliği
  lastLoginAt        DateTime? // Son giriş tarihi
  isActive           Boolean   @default(true) // Aktif mi?

  // İlişkiler
  students ParentStudent[] // Bu hesaba bağlı veliler (anne, baba, vasi)

  // İç Haberleşme (Chat)
  chatParticipants ConversationParticipant[] @relation("ParentChatParticipants")
  sentMessages     Message[]                 @relation("ParentSentMessages")
  messageReceipts  MessageReceipt[]          @relation("ParentMessageReceipts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentTcNumber])
  @@index([isActive])
  @@map("parents")
}

// Veli-Öğrenci İlişkisi (Pivot Table)
// Bir Parent hesabına birden fazla veli bağlanabilir (anne, baba, vasi)
model ParentStudent {
  id        String         @id @default(cuid())
  parentId  String // Parent hesabı (öğrenci TC bazlı)
  studentId String // Öğrenci ID
  relation  ParentRelation // ANNE, BABA, VASI

  // Veli bilgileri
  parentName     String // Velinin adı soyadı
  parentTcNumber String // Velinin kendi TC'si
  parentPhone    String? // Velinin telefonu
  parentEmail    String? // Velinin e-postası

  // Relations
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, studentId, relation]) // Bir hesapta her veli tipi (anne/baba) bir kez olabilir
  @@index([parentId])
  @@index([studentId])
  @@index([parentTcNumber])
  @@map("parent_students")
}

// Veli-Öğrenci İlişki Tipi
enum ParentRelation {
  ANNE
  BABA
  VASI
}

// ============================================
// FAZ 2: ÖDEVLENDİRME & YOKLAMA MODÜLÜ
// ============================================

// Ödev Modeli
model Homework {
  id String @id @default(cuid())

  // Ödev bilgileri
  title       String // Ödev başlığı
  description String   @db.Text // Ödev açıklaması (detaylı)
  dueDate     DateTime // Teslim tarihi
  subject     String? // Ders adı (opsiyonel)

  // Öğretmen bilgileri
  teacherId String // Ödevi veren öğretmen
  teacher   Staff  @relation("TeacherHomeworks", fields: [teacherId], references: [id], onDelete: Cascade)

  // Sınıf bilgileri
  classId String? // Sınıf (tüm sınıfa verilirse)
  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)

  // Ek bilgiler
  attachmentUrl String? // Ek dosya URL'si (Vercel Blob)
  isActive      Boolean @default(true) // Aktif mi?

  // İlişkiler
  assignments HomeworkAssignment[] // Ödev atamaları (öğrenci bazlı)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([classId])
  @@index([dueDate])
  @@index([isActive])
  @@map("homeworks")
}

// Ödev Ataması (Öğrenci Bazlı)
model HomeworkAssignment {
  id String @id @default(cuid())

  homeworkId String // Ödev ID
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  studentId String // Öğrenci ID
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Durum bilgileri
  isCompleted Boolean   @default(false) // Tamamlandı mı?
  completedAt DateTime? // Tamamlanma tarihi
  completedBy String? // Kim tamamladı (öğretmen veya öğrenci)
  note        String? // Öğretmen notu

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([homeworkId, studentId]) // Bir öğrenci aynı ödevi birden fazla kez alamaz
  @@index([homeworkId])
  @@index([studentId])
  @@index([isCompleted])
  @@map("homework_assignments")
}

// Yoklama Modeli
model Attendance {
  id String @id @default(cuid())

  // Ders bilgileri
  scheduleId String? // Ders programı ID (opsiyonel)
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  classId String // Sınıf ID
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  teacherId String // Öğretmen ID
  teacher   Staff  @relation("TeacherAttendances", fields: [teacherId], references: [id], onDelete: Cascade)

  // Yoklama bilgileri
  date       DateTime // Yoklama tarihi
  lessonName String // Ders adı
  startTime  String // Ders başlangıç saati (HH:mm)
  endTime    String // Ders bitiş saati (HH:mm)

  // Öğrenci yoklama durumu
  studentId String // Öğrenci ID
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status AttendanceStatus @default(PRESENT) // Durum: Geldi, Gelmedi, İzinli, Geç Kaldı
  note   String? // Not (opsiyonel)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
  @@index([classId])
  @@index([teacherId])
  @@index([studentId])
  @@index([date])
  @@index([status])
  @@map("attendances")
}

// Yoklama Durumu
enum AttendanceStatus {
  PRESENT // Geldi
  ABSENT // Gelmedi
  LATE // Geç Kaldı
  EXCUSED // İzinli
}

// ============================================
// FAZ 3: SINAV ANALİZİ MODÜLÜ
// ============================================

// Sınav Modeli
model Exam {
  id String @id @default(cuid())

  // Sınav bilgileri
  name        String // "2024-2025 1. Dönem Deneme Sınavı"
  examType    ExamType // YKS, LGS, KPSS, DIGER
  examDate    DateTime // Sınav tarihi
  grade       Int? // Hangi sınıf seviyesi (9, 10, 11, 12) - opsiyonel (tüm okul için null)
  description String?  @db.Text // Sınav hakkında açıklama

  // Sınıf bazlı sınav (opsiyonel)
  classId String? // Belirli bir sınıfa özel sınav
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  // Sınav detayları (JSON olarak saklanabilir veya ayrı alanlar)
  subjects Json? // Dersler ve puan türleri örn: {"TYT": {...}, "AYT": {...}}

  // Oluşturan
  createdById String // Rehberlik uzmanı Staff ID
  createdBy   Staff  @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  // İlişkiler
  results ExamResult[] // Sınav sonuçları

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([grade])
  @@index([classId])
  @@index([examType])
  @@index([examDate])
  @@map("exams")
}

// Sınav Sonucu (Öğrenci Bazlı)
model ExamResult {
  id String @id @default(cuid())

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Sonuç bilgileri (JSON olarak saklanır - esneklik için)
  // Örnek: {
  //   "TYT": {"turkce": 35, "matematik": 30, "toplam": 120, "net": 98.5},
  //   "AYT": {"matematik": 25, "fizik": 20, ...},
  //   "totalScore": 450,
  //   "ranking": 1250
  // }
  scores Json // Sınav sonuçları (ders bazlı)

  // Genel bilgiler
  totalScore Float? // Toplam puan
  ranking    Int? // Sıralama
  percentile Float? // Yüzdelik dilim

  // Notlar
  notes String? @db.Text // Rehberlik notları

  // Kim girdi
  enteredById String // Rehberlik uzmanı Staff ID
  enteredBy   Staff  @relation("ExamResultEntry", fields: [enteredById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId]) // Bir öğrenci aynı sınava birden fazla kez girilemez
  @@index([examId])
  @@index([studentId])
  @@index([totalScore])
  @@index([ranking])
  @@map("exam_results")
}

// Sınav Tipi
enum ExamType {
  YKS // Yükseköğretim Kurumları Sınavı
  LGS // Liselere Geçiş Sınavı
  KPSS // Kamu Personeli Seçme Sınavı
  DENEME // Deneme Sınavı
  DIGER // Diğer
}

// ============================================
// FAZ 4: GÖRÜŞ GİRİŞİ MODÜLÜ
// ============================================

// Öğrenci Görüş/Yorum Modeli
model StudentComment {
  id String @id @default(cuid())

  // Öğrenci bilgisi
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Yazan kişi (Öğretmen veya Rehberlik)
  staffId String
  staff   Staff  @relation("StaffComments", fields: [staffId], references: [id], onDelete: Cascade)

  // Görüş bilgileri
  commentType CommentType // ACADEMIC, BEHAVIORAL, GENERAL
  category    String? // Ders adı veya alan (örn: "Matematik", "Sosyal Gelişim")
  content     String      @db.Text // Görüş içeriği
  isPositive  Boolean     @default(true) // Olumlu/Olumsuz

  // İlişkiler
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([staffId])
  @@index([commentType])
  @@index([createdAt])
  @@map("student_comments")
}

// Görüş Tipi
enum CommentType {
  ACADEMIC // Akademik (Ders başarısı, not durumu)
  BEHAVIORAL // Davranışsal (Sınıf içi davranış, sosyal ilişkiler)
  GENERAL // Genel (Diğer gözlemler)
}

// ============================================
// İÇ HABERLEŞME (CHAT) MODÜLÜ
// Yalnızca Staff ve Parent arasında çalışır.
// ============================================

enum ConversationType {
  PRIVATE // 1:1 özel sohbet
  GROUP // Grup sohbeti (yöneticilerin oluşturduğu)
  ANNOUNCEMENT // Duyuru kanalı (sadece adminler mesaj atabilir)
}

enum ParticipantRole {
  ADMIN // Sohbet yöneticisi (yalnızca grup/duyuruda anlamlı)
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
}

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType
  title     String? // Grup veya duyuru kanalı adı (PRIVATE için null)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([type])
  @@index([updatedAt])
  @@map("conversations")
}

// Sohbet katılımcıları. Polymorphic: tam olarak staffId VEYA parentId dolu olur.
model ConversationParticipant {
  id             String          @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ParticipantRole @default(MEMBER)

  staffId  String?
  staff    Staff?  @relation("StaffChatParticipants", fields: [staffId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Parent? @relation("ParentChatParticipants", fields: [parentId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([conversationId, staffId])
  @@unique([conversationId, parentId])
  @@index([conversationId])
  @@index([staffId])
  @@index([parentId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Polymorphic gönderici
  senderStaffId  String?
  senderStaff    Staff?  @relation("StaffSentMessages", fields: [senderStaffId], references: [id], onDelete: SetNull)
  senderParentId String?
  senderParent   Parent? @relation("ParentSentMessages", fields: [senderParentId], references: [id], onDelete: SetNull)

  body          String      @db.Text
  type          MessageType @default(TEXT)
  attachmentUrl String? // Vercel Blob URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts MessageReceipt[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([senderStaffId])
  @@index([senderParentId])
  @@map("messages")
}

model MessageReceipt {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Polymorphic okuyucu
  readerStaffId  String?
  readerStaff    Staff?  @relation("StaffMessageReceipts", fields: [readerStaffId], references: [id], onDelete: Cascade)
  readerParentId String?
  readerParent   Parent? @relation("ParentMessageReceipts", fields: [readerParentId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([messageId, readerStaffId])
  @@unique([messageId, readerParentId])
  @@index([messageId])
  @@index([readerStaffId])
  @@index([readerParentId])
  @@map("message_receipts")
}
