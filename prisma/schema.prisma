// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  tcNumber         String   @unique
  birthDate        DateTime
  grade            String // Sınıf (zorunlu)
  phone            String?
  email            String?
  address          String // Adres (zorunlu)
  // Anne Bilgileri (Zorunlu)
  motherName       String
  motherTc         String
  motherPhone      String
  motherAddress    String
  motherOccupation String

  // Baba Bilgileri (Zorunlu)
  fatherName       String
  fatherTc         String
  fatherPhone      String
  fatherAddress    String
  fatherOccupation String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  // Relations
  clubSelections   ClubSelection[]
  newRegistrations NewRegistration[]
  renewals         Renewal[]
  uniformContracts UniformContract[]
  mealContracts    MealContract[]
  serviceContracts ServiceContract[]
  bookContracts    BookContract[]
  activities       Activity[]
  parentMeetings   ParentMeeting[]

  @@map("students")
}

model Club {
  id          String   @id @default(cuid())
  name        String
  description String?
  capacity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  // Relations
  selections ClubSelection[]

  @@map("clubs")
}

model ClubSelection {
  id        String   @id @default(cuid())
  studentId String
  clubId    String
  createdAt DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([studentId, clubId])
  @@map("club_selections")
}

model NewRegistration {
  id           String   @id @default(cuid())
  studentId    String
  // Yeni kayıt sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("new_registrations")
}

model Renewal {
  id           String   @id @default(cuid())
  studentId    String
  // Kayıt yenileme sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("renewals")
}

model UniformContract {
  id           String   @id @default(cuid())
  studentId    String
  // Forma sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("uniform_contracts")
}

model MealContract {
  id           String   @id @default(cuid())
  studentId    String
  // Yemek sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("meal_contracts")
}

model ServiceContract {
  id           String   @id @default(cuid())
  studentId    String
  // Servis sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("service_contracts")
}

model BookContract {
  id           String   @id @default(cuid())
  studentId    String
  // Kitap sözleşmesi alanları
  contractData Json
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("book_contracts")
}

// Başvuru sisteminden gelen başvurular
model Basvuru {
  id             String   @id @default(cuid())
  externalId     String   @unique // Başvuru sistemindeki ID
  ogrenciAdSoyad String
  ogrenciTc      String
  okul           String
  ogrenciSinifi  String
  ogrenciSube    String   @default("Belirtilmedi")
  sinavGunu      String   @default("Belirtilmedi")
  babaAdSoyad    String
  babaMeslek     String
  babaIsAdresi   String   @default("")
  babaCepTel     String
  anneAdSoyad    String
  anneMeslek     String
  anneIsAdresi   String   @default("")
  anneCepTel     String
  email          String
  createdAt      DateTime @default(now())
  syncedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([externalId])
  @@index([ogrenciTc])
  @@index([email])
  @@index([createdAt])
  @@map("basvurular")
}

// IB Programı - Öğrenci Faaliyet Kayıtları
enum ActivityType {
  ETKINLIK // Etkinlik
  GEZI // Gezi
  PROJE // Proje
  SINAV // Sınav
  YARISMA // Yarışma
  SEMINER // Seminer
  WORKSHOP // Workshop
  SPORT // Spor
  SANAT // Sanat
  SOSYAL // Sosyal Sorumluluk
  DIL // Dil Faaliyeti
  BILIM // Bilim
  DEGER // Değerler Eğitimi
  DIGER // Diğer
}

model Activity {
  id           String       @id @default(cuid())
  studentId    String
  type         ActivityType
  title        String // Faaliyet başlığı
  description  String? // Detaylı açıklama
  activityDate DateTime // Faaliyet tarihi (IMMUTABLE - değiştirilemez)
  location     String? // Konum
  organizer    String? // Organizatör/Koordinatör
  duration     Int? // Süre (dakika)
  participants Int? // Katılımcı sayısı
  outcome      String? // Sonuç/Kazanım
  evidence     String? // Kanıt (dosya yolu, link vb.)
  isVerified   Boolean      @default(false) // Doğrulandı mı?
  verifiedBy   String? // Doğrulayan kişi
  verifiedAt   DateTime? // Doğrulama tarihi
  notes        String? // Notlar
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  // Tarih değişikliği koruması için - activityDate asla güncellenemez
  createdBy    String? // Oluşturan kullanıcı

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([activityDate])
  @@index([type])
  @@index([isVerified])
  @@map("activities")
}

// IB Programı - Dışarıdan Görüntüleme Yetkisi
model IBViewer {
  id           String    @id @default(cuid())
  username     String    @unique // Özel kullanıcı adı
  password     String // Hash'lenmiş şifre (bcrypt)
  fullName     String // IB Personeli adı
  email        String? // İletişim email
  organization String? // Organizasyon
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([username])
  @@index([isActive])
  @@map("ib_viewers")
}

// Veli Görüşmeleri - Rehberlik Danışmanı Notları
model ParentMeeting {
  id            String   @id @default(cuid())
  studentId     String
  meetingDate   DateTime // Görüşme tarihi
  notes         String // Görüşme notları/detayları
  counselorName String? // Rehberlik danışmanı adı (opsiyonel)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String? // Oluşturan kullanıcı (opsiyonel)

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([meetingDate])
  @@map("parent_meetings")
}

// Personel Yönetimi - Okul Çalışanları
enum StaffDepartment {
  OGRETMEN        // Öğretmen
  OGRENCI_ISLERI  // Öğrenci İşleri
  MUDUR           // Müdür
  MUDUR_YARDIMCISI // Müdür Yardımcısı
  REHBERLIK       // Rehberlik
  MUHASEBE        // Muhasebe
  GUZEL_SANATLAR  // Güzel Sanatlar
  SPOR            // Spor
  KUTUPHANE       // Kütüphane
  TEKNIK          // Teknik Personel
  TEMIZLIK        // Temizlik
  GUVENLIK        // Güvenlik
  DIGER           // Diğer
}

model Staff {
  id          String         @id @default(cuid())
  firstName   String
  lastName    String
  tcNumber    String         @unique
  email       String?
  phone       String?
  department  StaffDepartment
  position    String?        // Pozisyon (Müdür, Müdür Yardımcısı, Sınıf Öğretmeni, vs.)
  subject     String?        // Branş/Ders (öğretmenler için)
  isActive    Boolean        @default(true)
  hireDate    DateTime?      // İşe başlama tarihi
  notes       String?        // Notlar
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tcNumber])
  @@index([department])
  @@index([isActive])
  @@index([firstName, lastName])
  
  // Relations
  subjectAssignments SubjectAssignment[]

  @@map("staff")
}

// Neredeyiz Modülü - Yıllık Plan Takip Sistemi

enum DisruptionType {
  PLANLI_OKUL        // Planlı/Okul Kaynaklı (Gezi, tören, veli toplantısı, müfettiş ziyareti)
  PLANDISI_DOGAL     // Plan Dışı/Doğal (Kar tatili, sel, elektrik kesintisi)
  OGRETMEN_KAYNAKLI  // Öğretmen Kaynaklı (Hastalık, hizmet içi eğitim)
}

enum HolidayType {
  RESMI_TATIL        // Resmi Tatil (Ulusal ve Dini bayramlar)
  YARILYIL_TATILI    // Yarıyıl Tatili
  ARA_TATIL          // Ara Tatil
  DIGER              // Diğer
}

enum ProgressStatus {
  PLANLANDI          // Planlandı (henüz başlanmadı)
  DEVAM_EDIYOR       // Devam Ediyor
  TAMAMLANDI         // Tamamlandı
  ERTELENDI          // Ertelendi
}

// Akademik Yıl
model AcademicYear {
  id          String   @id @default(cuid())
  name        String   // Örn: "2024-2025 Eğitim Öğretim Yılı"
  startDate   DateTime // Başlangıç tarihi
  endDate     DateTime // Bitiş tarihi
  isActive    Boolean  @default(false) // Aktif akademik yıl
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  subjects    Subject[]
  holidays    Holiday[]
  disruptions Disruption[]

  @@index([isActive])
  @@index([startDate, endDate])
  @@map("academic_years")
}

// Ders
model Subject {
  id            String   @id @default(cuid())
  academicYearId String
  name          String   // Örn: "Geometri"
  code          String?  // Ders kodu
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  units        Unit[]
  assignments  SubjectAssignment[]

  @@index([academicYearId])
  @@index([name])
  @@map("subjects")
}

// Ders-Öğretmen Atama
model SubjectAssignment {
  id        String   @id @default(cuid())
  subjectId String
  staffId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([subjectId, staffId])
  @@index([subjectId])
  @@index([staffId])
  @@map("subject_assignments")
}

// Ünite
model Unit {
  id          String   @id @default(cuid())
  subjectId   String
  name        String   // Örn: "Üçgenler"
  order       Int      // Sıralama
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@index([subjectId])
  @@index([subjectId, order])
  @@map("units")
}

// Konu
model Topic {
  id                String   @id @default(cuid())
  unitId            String
  name              String   // Örn: "Üçgenin İç Açıları"
  order             Int      // Sıralama
  plannedStartWeek  Int?     // Planlanan başlangıç haftası
  plannedEndWeek    Int?     // Planlanan bitiş haftası
  plannedStartDate  DateTime? // Planlanan başlangıç tarihi
  plannedEndDate    DateTime? // Planlanan bitiş tarihi
  estimatedDuration Int?     // Tahmini süre (gün)
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  subTopics SubTopic[]
  progress  Progress[]

  @@index([unitId])
  @@index([unitId, order])
  @@index([plannedStartDate])
  @@index([plannedEndDate])
  @@map("topics")
}

// Alt Konu (Opsiyonel)
model SubTopic {
  id          String   @id @default(cuid())
  topicId     String
  name        String
  order       Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([topicId, order])
  @@map("sub_topics")
}

// Tatil
model Holiday {
  id          String     @id @default(cuid())
  academicYearId String
  name        String     // Örn: "Kurban Bayramı", "Yarıyıl Tatili"
  type        HolidayType
  startDate   DateTime
  endDate     DateTime
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([academicYearId])
  @@index([startDate, endDate])
  @@index([type])
  @@map("holidays")
}

// Aksama
model Disruption {
  id          String         @id @default(cuid())
  academicYearId String
  type        DisruptionType
  reason      String         // Aksama sebebi (detaylı açıklama)
  startDate   DateTime
  endDate     DateTime
  affectedSubjects String[]  // Etkilenen dersler (Subject ID'leri)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String?        // Oluşturan kullanıcı

  // Relations
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([academicYearId])
  @@index([startDate, endDate])
  @@index([type])
  @@map("disruptions")
}

// İlerleme Takibi
model Progress {
  id              String         @id @default(cuid())
  topicId         String
  status          ProgressStatus @default(PLANLANDI)
  plannedDate     DateTime?      // Planlanan tarih
  actualStartDate DateTime?      // Gerçek başlangıç tarihi
  actualEndDate   DateTime?      // Gerçek bitiş tarihi
  notes           String?        // Notlar
  reportedBy      String?        // Bildiren öğretmen (Staff ID)
  markedBy        String?        // İşaretleyen (Rehberlik Danışmanı)
  markedAt        DateTime?      // İşaretleme tarihi
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([status])
  @@index([actualEndDate])
  @@map("progress")
}
