# Database
DATABASE_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Gezi Modülü
GEZI_API_URL=
SERVICE_API_SECRET=

# Bursluluk / Yaz Okulu webhook (basvuru-sistemi)
WEBHOOK_SECRET=

# Muhasebe entegrasyonu (kurucu finans paneli)
# Aynı INTEGRATION_SECRET muhasebe Vercel env'de de olmalı
MUHASEBE_URL=
INTEGRATION_SECRET=

# İç Haberleşme (Chat) - Pusher Channels
# Sunucu tarafı (gizli)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
# Hem sunucu hem istemci tarafı için cluster (örn: eu, mt1)
NEXT_PUBLIC_PUSHER_CLUSTER=
# İstemci tarafına aktarılan public key (sunucudaki PUSHER_KEY ile aynı değer olmalı)
NEXT_PUBLIC_PUSHER_KEY=

# Chat dosya yükleme limiti (bytes); varsayılan 10MB
CHAT_MAX_BYTES=10485760

# Oturum token imzası (HMAC-SHA256) — zorunlu (production'da yoksa giriş 500 verir).
# Üretmek için: openssl rand -base64 48
AUTH_TOKEN_SECRET=
# Geçiş dönemi: imzasız eski token'ları kabul et (varsayılan true). Kapatmak için false.
AUTH_ACCEPT_LEGACY_TOKENS=true
# Personel oturum süresi (ms); varsayılan 15 gün
# STAFF_TOKEN_MAX_AGE_MS=1296000000
